getgenv().autotrain = false
local Status = {FastSlash = false, Speed = false, X2Stat = false, Safezone = false, InfJump = false}

local safePlatform = nil
local safePosition = Vector3.new(0, 5000, 0)
local lastPosition = nil

local function updateToggleVisual(btn, isEnabled)
    if isEnabled then
        btn.BackgroundColor3 = Color3.fromRGB(65, 185, 120)
    else
        btn.BackgroundColor3 = Color3.fromRGB(45, 60, 52)
    end
end

-- เธเธฑเธเธเนเธเธฑเธเธ”เธถเธเนเธญเน€เธ—เธกเธเธฃเธฐเน€เธ เธ—เธ”เธฒเธเนเธฅเธฐเธเธ”เธชเธงเธดเธ
local function train()
    local char = Player.Character or Player.CharacterAdded:Wait()
    local sword = char:FindFirstChildOfClass("Tool")
    if sword then
        sword:Activate()
    end
end

-- 1. Auto Train
ToggleTrain.MouseButton1Click:Connect(function()
    getgenv().autotrain = not getgenv().autotrain
    updateToggleVisual(ToggleTrain, getgenv().autotrain)
    
    if getgenv().autotrain then
        task.spawn(function()
            while getgenv().autotrain do
                train()
                task.wait(0.000001)
            end
        end)
    end
end)

-- 2. Fast Slash
ToggleFastSlash.MouseButton1Click:Connect(function()
    Status.FastSlash = not Status.FastSlash
    updateToggleVisual(ToggleFastSlash, Status.FastSlash)
    if Status.FastSlash then
        task.spawn(function()
            local events = game:GetService("ReplicatedStorage"):WaitForChild("Events")
            local wepEvent = events:WaitForChild("WeaponEvent")
            local ninEvent = events:WaitForChild("NinjutsuEvent")
            while Status.FastSlash do
                wepEvent:FireServer("Swing")
                ninEvent:FireServer("Train")
                task.wait(0.01)
            end
        end)
    end
end)

-- 3. WalkSpeed x2
ToggleSpeed.MouseButton1Click:Connect(function()
    Status.Speed = not Status.Speed
    updateToggleVisual(ToggleSpeed, Status.Speed)
    if Status.Speed then
        task.spawn(function()
            while Status.Speed do
                if Player.Character and Player.Character:FindFirstChild("Humanoid") then
                    if Player.Character.Humanoid.WalkSpeed ~= 100 then
                        Player.Character.Humanoid.WalkSpeed = 100
                    end
                end
                task.wait(0.5)
            end
        end)
    else
        if Player.Character and Player.Character:FindFirstChild("Humanoid") then
            Player.Character.Humanoid.WalkSpeed = 16
        end
    end
end)

