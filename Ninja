    label.Parent = rowFrame
    label.BackgroundTransparency = 1
    label.Position = UDim2.new(0, 12, 0, 0)
    label.Size = UDim2.new(0, 200, 1, 0)
    label.Font = Enum.Font.SourceSansSemibold
    label.Text = text
    label.TextColor3 = Color3.fromRGB(180, 200, 190)
