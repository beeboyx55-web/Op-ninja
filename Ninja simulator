-- สร้างหัวข้อหมวดหมู่
local function createCategoryHeader(text, yPos)
    local header = Instance.new("TextLabel")
    header.Parent = MainFrame
    header.BackgroundTransparency = 1
    header.Position = UDim2.new(0, 15, 0, yPos)
    header.Size = UDim2.new(1, -30, 0, 20)
    header.Font = Enum.Font.SourceSansBold
    header.Text = text
    header.TextColor3 = Color3.fromRGB(75, 120, 95)
    header.TextSize = 13
    header.TextXAlignment = Enum.TextXAlignment.Left
    return header
end

-- สร้างปุ่ม Toggle
local function createModernToggle(text, yPos)
    local rowFrame = Instance.new("Frame")
    rowFrame.Parent = MainFrame
    rowFrame.BackgroundColor3 = Color3.fromRGB(22, 38, 32)
    rowFrame.Position = UDim2.new(0, 15, 0, yPos)
    rowFrame.Size = UDim2.new(1, -30, 0, 40)
    rowFrame.BorderSizePixel = 0

    local rowCorner = Instance.new("UICorner")
    rowCorner.CornerRadius = UDim.new(0, 6)
    rowCorner.Parent = rowFrame

    local label = Instance.new("TextLabel")
    label.Parent = rowFrame
    label.BackgroundTransparency = 1
    label.Position = UDim2.new(0, 12, 0, 0)
    label.Size = UDim2.new(0, 200, 1, 0)
    label.Font = Enum.Font.SourceSansSemibold
    label.Text = text
    label.TextColor3 = Color3.fromRGB(180, 200, 190)
    label.TextSize = 14
    label.TextXAlignment = Enum.TextXAlignment.Left

    local toggleBtn = Instance.new("TextButton")
    toggleBtn.Parent = rowFrame
    toggleBtn.BackgroundColor3 = Color3.fromRGB(45, 60, 52)
    toggleBtn.Position = UDim2.new(1, -32, 0, 11)
    toggleBtn.Size = UDim2.new(0, 18, 0, 18)
    toggleBtn.Text = ""
    toggleBtn.AutoButtonColor = false

    local circleCorner = Instance.new("UICorner")
    circleCorner.CornerRadius = UDim.new(1, 0)
    circleCorner.Parent = toggleBtn

    return toggleBtn
end

createCategoryHeader("Misc", 45)

local ToggleTrain = createModernToggle("Auto Train", 70)
local ToggleFastSlash = createModernToggle("Fast Slash", 115)
local ToggleX2Stat = createModernToggle("x2 Ninjutsu & Soul", 160)

createCategoryHeader("Player", 210)

local ToggleSpeed = createModernToggle("WalkSpeed x2", 235)
local ToggleSafezone = createModernToggle("Create Safezone", 280)
local ToggleInfJump = createModernToggle("Infinite Jumps", 325)

-- เปิด/ปิดเมนูด้วยปุ่ม F
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if not gameProcessed and input.KeyCode == Enum.KeyCode.F then
        MainFrame.Visible = not MainFrame.Visible
    end
end)

local Status = {
    AutoTrain = false,
    FastSlash = false,
    Speed = false,
    X2Stat = false,
    Safezone = false,
    InfJump = false
}

local safePlatform = nil
local safePosition = Vector3.new(0, 5000, 0)
local lastPosition = nil

local function updateToggleVisual(button, enabled)
    if enabled then
        button.BackgroundColor3 = Color3.fromRGB(65, 185, 120)
    else
        button.BackgroundColor3 = Color3.fromRGB(45, 60, 52)
    end
end

-- ฟังก์ชันฝึกด้วยอาวุธที่ถืออยู่
local function train()
    local character = Player.Character or Player.CharacterAdded:Wait()
    local tool = character:FindFirstChildOfClass("Tool")

    if tool then
        tool:Activate()
    end
end

-- 1. Auto Train
ToggleTrain.MouseButton1Click:Connect(function()
    Status.AutoTrain = not Status.AutoTrain
    updateToggleVisual(ToggleTrain, Status.AutoTrain)

    if Status.AutoTrain then
        task.spawn(function()
            while Status.AutoTrain do
                train()
                task.wait(0.05)
            end
        end)
    end
end)

-- 2. Fast Slash
ToggleFastSlash.MouseButton1Click:Connect(function()
    Status.FastSlash = not Status.FastSlash
    updateToggleVisual(ToggleFastSlash, Status.FastSlash)

    if Status.FastSlash then
        task.spawn(function()
            local events = ReplicatedStorage:WaitForChild("Events")
            local weaponEvent = events:WaitForChild("WeaponEvent")
            local ninjutsuEvent = events:WaitForChild("NinjutsuEvent")

            while Status.FastSlash do
                weaponEvent:FireServer("Swing")
                ninjutsuEvent:FireServer("Train")
                task.wait(0.01)
            end
        end)
    end
end)

-- 3. WalkSpeed x2
ToggleSpeed.MouseButton1Click:Connect(function()
    Status.Speed = not Status.Speed
    updateToggleVisual(ToggleSpeed, Status.Speed)

    if Status.Speed then
        task.spawn(function()
            while Status.Speed do
                local character = Player.Character
                local humanoid = character and character:FindFirstChildOfClass("Humanoid")

                if humanoid then
                    humanoid.WalkSpeed = 32
                end

                task.wait(0.5)
            end
        end)
    else
        local character = Player.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")

        if humanoid then
            humanoid.WalkSpeed = 16
        end
    end
end)

-- 4. x2 Ninjutsu & Soul
ToggleX2Stat.MouseButton1Click:Connect(function()
    Status.X2Stat = not Status.X2Stat
    updateToggleVisual(ToggleX2Stat, Status.X2Stat)

    if Status.X2Stat then
        task.spawn(function()
            local events = ReplicatedStorage:WaitForChild("Events")
            local ninjutsuEvent = events:WaitForChild("NinjutsuEvent")
            local soulEvent = events:WaitForChild("SoulEvent")

            while Status.X2Stat do
                ninjutsuEvent:FireServer("Train")
                soulEvent:FireServer("Collect")
                task.wait(0.05)
            end
        end)
    end
end)

-- 5. Create Safezone
ToggleSafezone.MouseButton1Click:Connect(function()
    Status.Safezone = not Status.Safezone
    updateToggleVisual(ToggleSafezone, Status.Safezone)

    if Status.Safezone then
        local character = Player.Character
        local root = character and character:FindFirstChild("HumanoidRootPart")

        if root then
            lastPosition = root.CFrame
        end

        if not safePlatform or not safePlatform.Parent then
            safePlatform = Instance.new("Part")
            safePlatform.Name = "KemaluSafePlatform"
            safePlatform.Size = Vector3.new(50, 1, 50)
            safePlatform.Position = safePosition
            safePlatform.Anchored = true
            safePlatform.Material = Enum.Material.Glass
            safePlatform.Transparency = 0.5
            safePlatform.Parent = workspace
        end

        task.spawn(function()
            while Status.Safezone do
                local character = Player.Character
                local root = character and character:FindFirstChild("HumanoidRootPart")

                if root then
                    if (root.Position - safePosition).Magnitude > 30 then
                        root.CFrame = CFrame.new(safePosition + Vector3.new(0, 3, 0))
                    end
                end

                task.wait(1)
            end
        end)
    else
        if safePlatform then
            safePlatform:Destroy()
            safePlatform = nil
        end

        local character = Player.Character
        local root = character and character:FindFirstChild("HumanoidRootPart")

        if lastPosition and root then
            root.CFrame = lastPosition
        end
    end
end)

-- 6. Infinite Jumps
UserInputService.JumpRequest:Connect(function()
    if Status.InfJump then
        local character = Player.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")

        if humanoid then
            humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
        end
    end
end)

ToggleInfJump.MouseButton1Click:Connect(function()
    Status.InfJump = not Status.InfJump
    updateToggleVisual(ToggleInfJump, Status.InfJump)
end)
